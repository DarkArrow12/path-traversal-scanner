[
  {"id": "linux-passwd",   "os": "linux",   "category": "poc",     "path": "/etc/passwd",            "signature": "root:[x*]:0:0:",                              "note": "User enumeration; canonical Linux PoC"},
  {"id": "linux-version",  "os": "linux",   "category": "poc",     "path": "/proc/version",          "signature": "Linux version \\d+\\.\\d+",                     "note": "Kernel version"},
  {"id": "linux-shadow",   "os": "linux",   "category": "secrets", "path": "/etc/shadow",            "signature": "root:\\$[156yba]\\$",                          "note": "Password hashes; proves high-priv read"},
  {"id": "linux-sshkey",   "os": "linux",   "category": "secrets", "path": "/root/.ssh/id_rsa",      "signature": "-----BEGIN (RSA|OPENSSH) PRIVATE KEY-----",    "note": "SSH private key -> shell"},
  {"id": "linux-environ",  "os": "linux",   "category": "secrets", "path": "/proc/self/environ",     "signature": "(HOME=|PATH=|PWD=)",                           "note": "Process env; may leak secrets. Null-delimited"},
  {"id": "linux-aws",      "os": "linux",   "category": "secrets", "path": "/root/.aws/credentials", "signature": "aws_access_key_id",                            "note": "Long-lived AWS keys"},
  {"id": "linux-bashhist", "os": "linux",   "category": "secrets", "path": "/root/.bash_history",    "signature": "(?m)^(cd|ls|cat|sudo|export|ssh|curl|wget|mysql) ", "note": "Shell history; may leak inline secrets"},
  {"id": "linux-hosts",    "os": "linux",   "category": "config",  "path": "/etc/hosts",             "signature": "127\\.0\\.0\\.1\\s+localhost",                 "note": "Internal network topology"},
  {"id": "linux-hostname", "os": "linux",   "category": "config",  "path": "/etc/hostname",          "signature": "^[a-zA-Z0-9][a-zA-Z0-9\\-]{0,62}\\s*$",        "note": "Single-line host identity"},
  {"id": "linux-mysqlcnf", "os": "linux",   "category": "config",  "path": "/etc/mysql/my.cnf",      "signature": "\\[(mysqld|client|mysql)\\]",                  "note": "DB config; may reference socket/creds files"},
  {"id": "app-dotenv",     "os": "linux",   "category": "config",  "path": "/var/www/html/.env",     "signature": "(?m)^[A-Z][A-Z0-9_]*=",                        "note": "App secrets: DB creds, API keys, app key"},
  {"id": "app-gitconfig",  "os": "linux",   "category": "config",  "path": "/var/www/html/.git/config", "signature": "\\[core\\]",                                "note": "Exposed .git; enables source recovery"},
  {"id": "cloud-k8stoken", "os": "linux",   "category": "cloud",   "path": "/run/secrets/kubernetes.io/serviceaccount/token", "signature": "eyJ[A-Za-z0-9_-]{10,}\\.", "note": "K8s service-account JWT -> API access"},
  {"id": "cloud-docker",   "os": "linux",   "category": "cloud",   "path": "/root/.docker/config.json", "signature": "\"auths\"",                                 "note": "Registry credentials"},
  {"id": "src-index",      "os": "linux",   "category": "source",  "path": "/var/www/html/index.php", "signature": "<\\?php",                                     "note": "App source (when served raw); use php://filter to force-read"},
  {"id": "src-config",     "os": "linux",   "category": "source",  "path": "/var/www/html/config.php", "signature": "<\\?php",                                    "note": "App config source; often holds DB creds"},
  {"id": "win-ini",        "os": "windows", "category": "poc",     "path": "/windows/win.ini",       "signature": "\\[fonts\\]",                                  "note": "Canonical Windows PoC; always present"},
  {"id": "win-hosts",      "os": "windows", "category": "config",  "path": "/windows/system32/drivers/etc/hosts", "signature": "127\\.0\\.0\\.1\\s+localhost",   "note": "Windows hosts file"},
  {"id": "win-webconfig",  "os": "windows", "category": "config",  "path": "/inetpub/wwwroot/web.config", "signature": "<configuration>",                        "note": "IIS config; may leak conn strings"}
]
